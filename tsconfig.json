{
    "include": ["src/*.ts", "src/*.tsx"],
    "compilerOptions": {
      "target": "es2017",
      "lib": ["dom", "dom.iterable", "es2019"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "moduleResolution": "node",
      "module": "esnext",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": true,
      "jsx": "react-jsx"
    }
  }
  